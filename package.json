{
  "name": "ujjwal-dental-backend",
  "version": "1.0.0",
  "description": "Backend API for Ujjwal Dental Clinic Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seeds/index.js",
    "seed:patients": "node src/seeds/patients.seed.js",
    "seed:notifications": "node src/seeds/notifications.seed.js",
    "seed:clinics": "node src/seeds/clinics.seed.js",
    "seed:treatments": "node src/seeds/treatments.seed.js",
    "seed:labs": "node src/seeds/labs.seed.js",
    "seed:permissions": "node src/seeds/permissions.seed.js",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:coverage": "vitest run --coverage --config vitest.config.js"
  },
  "keywords": [
    "dental",
    "clinic",
    "management",
    "healthcare",
    "api"
  ],
  "author": "Ujjwal Dental Clinic",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.4",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.17.2",
    "razorpay": "^2.9.6",
    "resend": "^6.17.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.0"
  }
}
